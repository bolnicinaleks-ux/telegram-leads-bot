# Токен от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Необязательно: ID рабочей группы для заявок (бот должен быть её участником, ID вида -100...).
# Если пусто — заявки приходят каждому администратору в личку.
LEADS_CHAT_ID=

DB_PATH=data/bot.db
FORM_PATH=form.toml
TIMEZONE=Asia/Almaty

# Не больше N заявок в час от одного пользователя
RATE_LIMIT_PER_HOUR=3

# Google Sheets (необязательно). Пустой GOOGLE_SHEET_ID — выгрузка выключена.
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=Заявки
# Как часто повторять выгрузку, если Google был недоступен (сек)
SYNC_INTERVAL_SECONDS=60

# Демо-режим: клиент после отправки получает копию карточки владельца и может менять статус своей заявки
DEMO_MODE=0
